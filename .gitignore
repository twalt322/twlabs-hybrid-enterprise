# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files may contain environment-specific or sensitive values
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Transient lock info files
.terraform.tfstate.lock.info

# Saved Terraform plan files
*.tfplan
tfplan

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Optional: graph output
# *.dot

# Optional: destroy plan output
# planout